<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ModTestBridge</AssemblyName>
    <RootNamespace>ModTestBridge</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <!-- Keep in sync with package/manifest.json and Plugin.Version. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin into each dev profile. -->
  <Target Name="DeployToGale" AfterTargets="Build">
    <ItemGroup>
      <Profiles Include="$(GaleProfileDirs)" />
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="%(Profiles.Identity)/BepInEx/plugins/Spronglehump-ModTestBridge"
          SkipUnchangedFiles="true" Condition="Exists('%(Profiles.Identity)/BepInEx/plugins')" />
    <Message Importance="high" Text="ModTestBridge deployed to %(Profiles.Identity)" />
  </Target>

  <!-- Thunderstore/Hexium zip: dotnet build -c Release -t:Package -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoRoot)package/manifest.json')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
      <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Plugin.cs')), 'Version\s*=\s*"([^"]+)"').Groups[1].Value)</PluginVersion>
      <PackageStage>$(MSBuildThisFileDirectory)obj/package/</PackageStage>
      <PackageZip>$(RepoRoot)dist/Spronglehump-ModTestBridge-$(Version).zip</PackageZip>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(Version)' Or '$(PluginVersion)' != '$(Version)'"
           Text="Version mismatch: csproj $(Version), manifest.json $(ManifestVersion), Plugin.Version $(PluginVersion)" />

    <RemoveDir Directories="$(PackageStage)" />
    <!-- The package README is the short one (Hexium/Thunderstore show it); the full docs live on GitHub. -->
    <Copy SourceFiles="$(RepoRoot)package/manifest.json;$(RepoRoot)package/icon.png;$(RepoRoot)package/README.md;$(RepoRoot)CHANGELOG.md"
          DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)plugins" />
    <MakeDir Directories="$(RepoRoot)dist" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageZip)" />
  </Target>

</Project>

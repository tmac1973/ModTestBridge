#!/usr/bin/env bash
# mtb: the ModTestBridge client. Drives a running Valheim (with the ModTestBridge plugin) from a shell or an agent.
#
#   mtb status                          game state (starting/menu/loading/world), world, character, position
#   mtb cmd "<console command>"         run a console command, print what it printed
#   mtb run "<command>" "<text>" [s]    run a command, then wait (default 600 s) for a new log line containing text
#   mtb log [from] [contains]           log lines from line N (0-based), optionally only those containing text
#   mtb mark                            the log's current line number (pass it to mtb log to read what came after)
#   mtb tail [n] [contains]             the last n (default 40) log lines, optionally only those containing text
#   mtb wait-log "<text>" [s]           wait (default 600 s) for a new log line containing text; prints it
#   mtb wait-world [s]                  wait (default 300 s) until a character is in a world
#   mtb shot [name] [options]           save a screenshot, print its path (PNG; read it to see the game)
#        --size PX                         longer side in pixels (default 768; the screen is scaled down to it)
#        --at x,y,z --look x,y,z [--fov D] from a camera of its own at one point looking at another (no UI)
#        --day                             at noon (the time of day is put back afterwards)
#   mtb quit                            save, log out and quit the game
#   mtb start [world] [character]       back up the saves, launch the game straight into the world (autostart)
#   mtb restart [world] [character]     quit if running, back up, launch, wait until in the world
#   mtb backup [world] [character]      copy the character and world saves (only while the game isn't running)
#   mtb profiles                        mod-manager profiles that have ModTestBridge installed
#   mtb doctor                          show what mtb found (profile, token, launch, saves) and whether the game answers
#   mtb join [character] [host:port]    quit if running, back up, launch the game onto the test server, wait for it
#
# A dedicated test server (headless, on this machine): put "server" first.
#   mtb server start [world]            back up its world, launch the server (creating the world if new), wait until up
#   mtb server restart [world]          stop if running, back up, start
#   mtb server stop                     save and stop it
#   mtb server backup [world]           copy its world (only while it isn't running)
#   mtb server status|cmd|run|log|mark|tail|wait-log|wait-world|doctor   as above, in the server
#
# Settings come from the environment, else ./.mtb (searched upward from the current directory), else
# ~/.config/mtb/config (KEY=value lines). See README.md, "Configuring mtb".
set -euo pipefail

SETTINGS=(MTB_PROFILE MTB_PROFILE_DIR MTB_PORT MTB_WORLD MTB_CHARACTER MTB_TIMEOUT MTB_LAUNCH MTB_STEAM MTB_GAME_PATTERN
          MTB_SAVES_DIRS MTB_CLOUD_DIRS MTB_KEEP_BACKUPS
          MTB_SERVER_DIR MTB_SERVER_PROFILE_DIR MTB_SERVER_PORT MTB_SERVER_WORLD MTB_SERVER_SAVEDIR MTB_SERVER_GAME_PORT
          MTB_SERVER_PASSWORD MTB_SERVER_ARGS MTB_SERVER_LAUNCH MTB_SERVER_ADDRESS)
load_settings() {
  local -A keep=() ; local v f d
  for v in "${SETTINGS[@]}"; do [[ -n "${!v+x}" ]] && keep[$v]="${!v}"; done
  f="${XDG_CONFIG_HOME:-$HOME/.config}/mtb/config"; [[ -f "$f" ]] && source "$f"
  d="$PWD"; while [[ "$d" != "/" && -n "$d" ]]; do [[ -f "$d/.mtb" ]] && { source "$d/.mtb"; break; }; d="$(dirname "$d")"; done
  for v in "${!keep[@]}"; do printf -v "$v" "%s" "${keep[$v]}"; done
}
load_settings

APP=892970
SERVER=0; [[ "${1:-}" == server ]] && { SERVER=1; shift; }   # every command after "server" goes to the test server
if (( SERVER )); then PORT="${MTB_SERVER_PORT:-7812}"; else PORT="${MTB_PORT:-7811}"; fi
URL="http://127.0.0.1:$PORT"
case "${OSTYPE:-}" in msys*|cygwin*) WINDOWS=1 ;; *) WINDOWS=0 ;; esac
PY="$(command -v python3 || command -v python || true)"
[[ -n "$PY" ]] || { echo "mtb needs python3" >&2; exit 2; }
command -v curl >/dev/null || { echo "mtb needs curl" >&2; exit 2; }
json() { "$PY" -c "import sys,json; d=json.load(sys.stdin); $1"; }
urlq() { "$PY" -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$1"; }
lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }

# --- where things are ------------------------------------------------------------------------------------------------

# Mod-manager profile folders (Gale, r2modman), Linux and Windows.
manager_dirs() {
  local appdata="${APPDATA:-}"
  [[ $WINDOWS == 1 && -n "$appdata" ]] && appdata="$(cygpath -u "$appdata" 2>/dev/null || echo "$appdata")"
  for d in "$HOME/.local/share/com.kesomannen.gale/valheim/profiles" "$HOME/.config/r2modmanPlus-local/Valheim/profiles" \
           ${appdata:+"$appdata/com.kesomannen.gale/valheim/profiles"} ${appdata:+"$appdata/r2modmanPlus-local/Valheim/profiles"}; do
    [[ -d "$d" ]] && echo "$d"
  done
}
has_bridge() { compgen -G "$1/BepInEx/plugins/*/ModTestBridge.dll" >/dev/null || compgen -G "$1/BepInEx/plugins/ModTestBridge.dll" >/dev/null; }
bridge_profiles() { local m p; while read -r m; do for p in "$m"/*/; do has_bridge "${p%/}" && echo "${p%/}"; done; done < <(manager_dirs); return 0; }

profile_dir() {
  if (( SERVER )); then server_profile_dir; return; fi
  if [[ -n "${MTB_PROFILE_DIR:-}" ]]; then echo "$MTB_PROFILE_DIR"; return; fi
  if [[ -n "${MTB_PROFILE:-}" ]]; then
    local m; while read -r m; do [[ -d "$m/$MTB_PROFILE" ]] && { echo "$m/$MTB_PROFILE"; return; }; done < <(manager_dirs)
    echo "no mod-manager profile named $MTB_PROFILE (set MTB_PROFILE_DIR to the folder holding BepInEx)" >&2; return 1
  fi
  local found; found="$(bridge_profiles)"
  case "$(echo -n "$found" | grep -c '^' || true)" in
    1) echo "$found" ;;
    0) echo "no profile with ModTestBridge installed found; set MTB_PROFILE or MTB_PROFILE_DIR" >&2; return 1 ;;
    *) echo -e "several profiles have ModTestBridge; set MTB_PROFILE to one of:\n$found" >&2; return 1 ;;
  esac
}

steam_root() {
  if [[ $WINDOWS == 1 ]]; then echo "/c/Program Files (x86)/Steam"; return; fi
  for d in "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
    [[ -d "$d/steamapps" ]] && { echo "$d"; return; }
  done
}
steam_libraries() {
  local root; root="$(steam_root)"; [[ -n "$root" ]] || return 0
  echo "$root"
  [[ -f "$root/steamapps/libraryfolders.vdf" ]] && sed -n 's/^\s*"path"\s*"\(.*\)"/\1/p' "$root/steamapps/libraryfolders.vdf" | sed 's#\\\\#/#g'
}
# Valheim under Proton: its prefix (empty when Valheim runs natively).
proton_prefix() {
  [[ $WINDOWS == 1 ]] && return 0
  local l; while read -r l; do [[ -d "$l/steamapps/compatdata/$APP/pfx" ]] && { echo "$l/steamapps/compatdata/$APP/pfx"; return; }; done < <(steam_libraries | sort -u)
}
# Folders that hold characters_local/ and worlds_local/ (and, for older saves, characters/ and worlds/).
saves_dirs() {
  if (( SERVER )); then server_savedir; return; fi
  if [[ -n "${MTB_SAVES_DIRS:-}" ]]; then tr ':' '\n' <<<"$MTB_SAVES_DIRS"; return; fi
  local pfx; pfx="$(proton_prefix)"
  [[ -n "$pfx" ]] && echo "$pfx/drive_c/users/steamuser/AppData/LocalLow/IronGate/Valheim"
  [[ $WINDOWS == 1 ]] && echo "${USERPROFILE:+$(cygpath -u "$USERPROFILE" 2>/dev/null || echo "$USERPROFILE")}/AppData/LocalLow/IronGate/Valheim"
  [[ $WINDOWS == 0 ]] && echo "$HOME/.config/unity3d/IronGate/Valheim"
  return 0
}
# Steam Cloud save folders (userdata/<account>/892970/remote).
cloud_dirs() {
  (( SERVER )) && return 0   # the server's world is only ever local
  if [[ -n "${MTB_CLOUD_DIRS:-}" ]]; then tr ':' '\n' <<<"$MTB_CLOUD_DIRS"; return; fi
  local root; root="$(steam_root)"; [[ -n "$root" ]] || return 0
  for d in "$root"/userdata/*/$APP/remote; do [[ -d "$d" ]] && echo "$d"; done; return 0
}

TOKEN=""
token() {
  [[ -n "$TOKEN" ]] && return
  local dir; dir="$(profile_dir)"
  local f="$dir/BepInEx/config/ModTestBridge.token"
  [[ -f "$f" ]] || { echo "no token at $f: run the $( (( SERVER )) && echo server || echo game) once with ModTestBridge enabled (Enabled = true in BepInEx/config/Spronglehump.ModTestBridge.cfg)" >&2; exit 2; }
  TOKEN="$(tr -d '\r\n' <"$f")"
}
req() { token; curl -sS --max-time "${MTB_TIMEOUT:-30}" -H "X-Token: $TOKEN" "$@"; }
log_next() { req "$URL/log?from=0&contains=%00" | json 'print(d["next"])'; }

# --- the game process ------------------------------------------------------------------------------------------------

game_pattern() {
  [[ -n "${MTB_GAME_PATTERN:-}" ]] && { echo "$MTB_GAME_PATTERN"; return; }
  if [[ -n "$(proton_prefix)" ]]; then echo '[v]alheim\.exe'; else echo '[v]alheim\.x86_64'; fi   # never valheim_server
}
running() {
  if (( SERVER )); then server_running; return; fi
  if [[ $WINDOWS == 1 ]]; then tasklist //FI "IMAGENAME eq valheim.exe" 2>/dev/null | grep -qi '^valheim\.exe'; return; fi
  pgrep -f "$(game_pattern)" >/dev/null
}

# How the profile is launched: as Gale and r2modman launch it (Steam, with BepInEx's doorstop pointed at the profile).
launch_cmd() {
  local dir; dir="$(profile_dir)"; local preloader="$dir/BepInEx/core/BepInEx.Preloader.dll"
  if [[ -n "${MTB_LAUNCH:-}" ]]; then echo "$MTB_LAUNCH"; return; fi
  if [[ $WINDOWS == 1 ]]; then
    local steam="${MTB_STEAM:-$(steam_root)/steam.exe}"
    printf '%q -applaunch %s --doorstop-enabled true --doorstop-target-assembly %q' "$steam" $APP "$(cygpath -w "$preloader" 2>/dev/null || echo "$preloader")"
  elif [[ -n "$(proton_prefix)" ]]; then
    printf '%q -applaunch %s --doorstop-enabled true --doorstop-target-assembly %q' "${MTB_STEAM:-steam}" $APP "Z:$preloader"
  else
    return 1   # native Linux: the mod manager's launch script differs between versions; set MTB_LAUNCH
  fi
}
launch() {
  local world="$1" character="$2" cmd
  cmd="$(launch_cmd)" || { echo "don't know how to launch this setup (native Linux?): set MTB_LAUNCH; see README" >&2; exit 2; }
  nohup bash -c "$cmd -console -mtb-world $(printf %q "$world") -mtb-character $(printf %q "$character")" >/dev/null 2>&1 &
  echo "launching $(basename "$(profile_dir)") into $world as $character"
}
# The game, straight onto a server (Valheim's own -password answers its password prompt).
launch_join() {
  local address="$1" character="$2" cmd pw=""
  cmd="$(launch_cmd)" || { echo "don't know how to launch this setup (native Linux?): set MTB_LAUNCH; see README" >&2; exit 2; }
  [[ -n "${MTB_SERVER_PASSWORD:-}" ]] && pw=" -password $(printf %q "$MTB_SERVER_PASSWORD")"
  nohup bash -c "$cmd -console -mtb-server $(printf %q "$address") -mtb-character $(printf %q "$character")$pw" >/dev/null 2>&1 &
  echo "launching $(basename "$(profile_dir)") onto $address as $character"
}

# --- the dedicated test server ---------------------------------------------------------------------------------------

# The Valheim Dedicated Server install (Steam's free "Valheim Dedicated Server" tool).
server_dir() {
  if [[ -n "${MTB_SERVER_DIR:-}" ]]; then echo "$MTB_SERVER_DIR"; return; fi
  local l; while read -r l; do
    [[ -n "$l" && -d "$l/steamapps/common/Valheim dedicated server" ]] && { echo "$l/steamapps/common/Valheim dedicated server"; return; }
  done < <(steam_libraries | sort -u)
  echo "no Valheim Dedicated Server found (install it from Steam's Tools, or set MTB_SERVER_DIR)" >&2; return 1
}
# The folder holding the server's BepInEx/: the server install itself unless MTB_SERVER_PROFILE_DIR says otherwise.
server_profile_dir() { if [[ -n "${MTB_SERVER_PROFILE_DIR:-}" ]]; then echo "$MTB_SERVER_PROFILE_DIR"; else server_dir; fi; }
# Its saves (worlds_local/, adminlist.txt...) stay apart from the game's, so a test world never mixes with real ones.
server_savedir() { if [[ -n "${MTB_SERVER_SAVEDIR:-}" ]]; then echo "$MTB_SERVER_SAVEDIR"; else echo "$(server_profile_dir)/BepInEx/ModTestBridge/server-saves"; fi; }
server_state_dir() { echo "$(server_profile_dir)/BepInEx/ModTestBridge"; }
server_exe() { if [[ $WINDOWS == 1 ]]; then echo "$(server_dir)/valheim_server.exe"; else echo "$(server_dir)/valheim_server.x86_64"; fi; }
server_pid() { local f; f="$(server_state_dir 2>/dev/null)/server.pid"; [[ -f "$f" ]] && cat "$f"; return 0; }
# Only the server mtb started (by its pid), never another one running on this machine.
server_running() {
  local pid; pid="$(server_pid)"; [[ -n "$pid" ]] || return 1
  if [[ $WINDOWS == 1 ]]; then tasklist //FI "PID eq $pid" 2>/dev/null | grep -qi 'valheim_server'; return; fi
  [[ -r "/proc/$pid/cmdline" ]] && tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q 'valheim_server'
}
server_enabled() { grep -qiE '^\s*Enabled\s*=\s*true' "$(server_profile_dir)/BepInEx/config/Spronglehump.ModTestBridge.cfg" 2>/dev/null; }

# Everything a start needs, checked before anything is stopped or copied.
server_check() {
  local exe prof
  server_dir >/dev/null || exit 2; exe="$(server_exe)"; prof="$(server_profile_dir)"
  [[ -f "$exe" ]] || { echo "no server at $exe (set MTB_SERVER_DIR)" >&2; exit 2; }
  [[ -f "$prof/BepInEx/core/BepInEx.Preloader.dll" ]] || { echo "no BepInEx in $prof: install BepInExPack_Valheim there (see README, \"A dedicated test server\")" >&2; exit 2; }
  has_bridge "$prof" || { echo "ModTestBridge.dll isn't under $prof/BepInEx/plugins" >&2; exit 2; }
  server_enabled || { printf 'ModTestBridge is off in the server. Put this in %s:\n[General]\nEnabled = true\n' \
                        "$prof/BepInEx/config/Spronglehump.ModTestBridge.cfg" >&2; exit 2; }
  return 0
}

# Launch the server in the background with BepInEx from the server profile (doorstop, as BepInExPack's
# start_server_bepinex.sh does), the test world and its own save folder, not listed publicly; output to server.out.
server_launch() {
  local world="$1" dir prof saves state exe libs args
  dir="$(server_dir)"; prof="$(server_profile_dir)"; saves="$(server_savedir)"; state="$(server_state_dir)"; exe="$(server_exe)"
  mkdir -p "$saves" "$state"
  args=(-name "mtb $world" -port "${MTB_SERVER_GAME_PORT:-2456}" -world "$world" -savedir "$saves" -public 0)
  [[ -n "${MTB_SERVER_PASSWORD:-}" ]] && args+=(-password "$MTB_SERVER_PASSWORD")
  local extra=(); [[ -n "${MTB_SERVER_ARGS:-}" ]] && read -r -a extra <<<"$MTB_SERVER_ARGS"
  if [[ -n "${MTB_SERVER_LAUNCH:-}" ]]; then
    ( cd "$dir" || exit 2; nohup bash -c "$MTB_SERVER_LAUNCH $(printf '%q ' "${args[@]}" "${extra[@]}")" >"$state/server.out" 2>&1 & echo $! >"$state/server.pid" )
  elif [[ $WINDOWS == 1 ]]; then
    ( cd "$dir" || exit 2; nohup "$exe" --doorstop-enabled true --doorstop-target-assembly "$(cygpath -w "$prof/BepInEx/core/BepInEx.Preloader.dll")" \
        "${args[@]}" "${extra[@]}" >"$state/server.out" 2>&1 & echo $! >"$state/server.pid" )
  else
    libs="$prof/doorstop_libs"; [[ -f "$libs/libdoorstop_x64.so" ]] || libs="$dir/doorstop_libs"
    [[ -f "$libs/libdoorstop_x64.so" ]] || { echo "no doorstop_libs/libdoorstop_x64.so in $prof or $dir (it comes with BepInExPack_Valheim)" >&2; exit 2; }
    ( cd "$dir" || exit 2; DOORSTOP_ENABLED=1 DOORSTOP_TARGET_ASSEMBLY="$prof/BepInEx/core/BepInEx.Preloader.dll" \
        LD_LIBRARY_PATH="$libs:$dir/linux64:${LD_LIBRARY_PATH:-}" LD_PRELOAD="$libs/libdoorstop_x64.so${LD_PRELOAD:+:$LD_PRELOAD}" \
        SteamAppId=$APP nohup "$exe" "${args[@]}" "${extra[@]}" >"$state/server.out" 2>&1 & echo $! >"$state/server.pid" )
  fi
  echo "launching the test server: world $world, port ${MTB_SERVER_GAME_PORT:-2456}, saves in $saves"
}

# Wait until the server has loaded its world; fail early (with its last output) if it exits.
wait_server() {
  local end=$((SECONDS + $1)) st
  while (( SECONDS < end )); do
    server_running || { echo "the server stopped; the end of $(server_state_dir)/server.out:" >&2; tail -n 15 "$(server_state_dir)/server.out" >&2; return 1; }
    st=$(MTB_TIMEOUT=5 req "$URL/status" 2>/dev/null || true)
    [[ -n "$st" && "$(echo "$st" | json 'print(d["state"])')" == "world" ]] && { echo "$st"; return 0; }
    sleep 3
  done
  echo "timed out waiting for the server" >&2; return 1
}

server_stop() {
  running || { echo "the test server isn't running"; return 0; }
  req -X POST --data "" "$URL/quit" >/dev/null 2>&1 || true
  local end=$((SECONDS + 90)); while running && (( SECONDS < end )); do sleep 2; done
  if running; then   # the bridge didn't answer: Ctrl-C, which saves too
    echo "the server didn't quit through the bridge; interrupting it" >&2
    [[ $WINDOWS == 1 ]] && taskkill //PID "$(server_pid)" >/dev/null 2>&1 || kill -INT "$(server_pid)" 2>/dev/null || true
    end=$((SECONDS + 60)); while running && (( SECONDS < end )); do sleep 2; done
    running && { echo "the server didn't stop within 150 s (pid $(server_pid))" >&2; return 1; }
  fi
  rm -f "$(server_state_dir)/server.pid"; echo "test server stopped"
}

server_world() { WORLD="${1:-${MTB_SERVER_WORLD:-${MTB_WORLD:-}}}"; CHARACTER=""
  [[ -n "$WORLD" ]] || { echo "which world? pass it, or set MTB_SERVER_WORLD (or MTB_WORLD)" >&2; exit 2; }; }

server_doctor() {
  local dir prof ok=1
  if dir="$(server_dir 2>&1)"; then echo "server:     $dir"; else echo "server:     ?? $dir"; ok=0; fi
  if (( ok )); then
    prof="$(server_profile_dir)"; echo "profile:    $prof"
    [[ -f "$prof/BepInEx/core/BepInEx.Preloader.dll" ]] && echo "bepinex:    installed" || echo "bepinex:    ?? no BepInEx/core/BepInEx.Preloader.dll in $prof"
    has_bridge "$prof" && echo "plugin:     installed" || echo "plugin:     ?? ModTestBridge.dll not under $prof/BepInEx/plugins"
    server_enabled && echo "enabled:    true" || echo "enabled:    ?? not on (Enabled = true in $prof/BepInEx/config/Spronglehump.ModTestBridge.cfg)"
    [[ -f "$prof/BepInEx/config/ModTestBridge.token" ]] && echo "token:      found" || echo "token:      (none yet: written on the first start)"
    grep -qiE '^\s*WriteUnityLog\s*=\s*true' "$prof/BepInEx/config/BepInEx.cfg" 2>/dev/null && echo "unity log:  in LogOutput.log" \
      || echo "unity log:  ?? not in LogOutput.log: the game's own lines and Debug.Log are missing (WriteUnityLog = true in BepInEx.cfg)"
    echo "saves:      $(server_savedir)"
  fi
  echo "world:      ${MTB_SERVER_WORLD:-${MTB_WORLD:-(unset: MTB_SERVER_WORLD)}}   game port: ${MTB_SERVER_GAME_PORT:-2456}   bridge port: $PORT"
  echo "password:   $([[ -n "${MTB_SERVER_PASSWORD:-}" ]] && echo set || echo 'none (not listed publicly; anyone on your network could join)')"
  echo "running:    $(running && echo "yes (pid $(server_pid))" || echo no)"
  (( ok )) && echo "bridge:     $(MTB_TIMEOUT=5 req "$URL/status" 2>&1 || true)"
}

need_names() {
  WORLD="${1:-${MTB_WORLD:-}}"; CHARACTER="${2:-${MTB_CHARACTER:-}}"
  [[ -n "$WORLD" && -n "$CHARACTER" ]] || { echo "which world and character? pass them, or set MTB_WORLD and MTB_CHARACTER" >&2; exit 2; }
}

# Copies of the character and world (local and Steam Cloud saves), taken while the game isn't running; newest N kept.
backup() {
  running && { echo "not backing up while the $( (( SERVER )) && echo server || echo game) is running (saves may be half-written)" >&2; return 1; }
  local c w root dest d n=0
  c="$(lower "$CHARACTER")"; w="$(lower "$WORLD")"
  root="$(profile_dir)/BepInEx/ModTestBridge/backups"; dest="$root/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dest"
  while read -r d; do
    [[ -n "$d" ]] || continue
    [[ -n "$c" ]] && for sub in characters_local characters; do [[ -e "$d/$sub/$c.fch" ]] && cp -a "$d/$sub/$c.fch" "$dest/$sub-$c.fch" && n=$((n+1)); done
    [[ -n "$w" ]] && for sub in worlds_local worlds; do
      for name in "$WORLD" "$w"; do   # as typed (a server keeps the case), or lower case
        [[ -d "$d/$sub/$name" && ! -e "$dest/$sub-$name" ]] && cp -a "$d/$sub/$name" "$dest/$sub-$name" && n=$((n+1))   # chunked world (current format)
        for ext in db fwl; do [[ -e "$d/$sub/$name.$ext" && ! -e "$dest/$sub-$name.$ext" ]] && cp -a "$d/$sub/$name.$ext" "$dest/$sub-$name.$ext" && n=$((n+1)); done
      done
    done
  done < <(saves_dirs)
  while read -r d; do
    [[ -n "$d" ]] || continue
    [[ -e "$d/characters/$c.fch" ]] && cp -a "$d/characters/$c.fch" "$dest/cloud-$c.fch" && n=$((n+1))
    [[ -n "$w" && -e "$d/worlds/$w" ]] && cp -a "$d/worlds/$w" "$dest/cloud-world-$w" && n=$((n+1))
  done < <(cloud_dirs)
  ls "$root" | sort | head -n "-${MTB_KEEP_BACKUPS:-5}" | while read -r old; do rm -rf "${root:?}/$old"; done
  if (( n == 0 )); then echo "warning: found no saves for ${CHARACTER:-}${CHARACTER:+ / }${WORLD:-} to back up (see mtb doctor)" >&2; rmdir "$dest"
  else echo "backed up to $dest: $(ls "$dest" | tr '\n' ' ')"; fi
}

wait_log() { # text timeout from
  local text="$1" timeout="$2" from="$3" end=$((SECONDS + $2)) out hit
  while (( SECONDS < end )); do
    out=$(req "$URL/log?from=$from&contains=$(urlq "$text")") || { sleep 5; continue; }
    hit=$(echo "$out" | json 'print("\n".join(d["lines"]))')
    [[ -n "$hit" ]] && { echo "$hit"; return 0; }
    sleep 3
  done
  echo "timed out after ${timeout}s waiting for: $text" >&2; return 1
}

wait_in_world() { # timeout; fails early if autostart refused
  local end=$((SECONDS + $1)) st state auto
  while (( SECONDS < end )); do
    st=$(MTB_TIMEOUT=5 req "$URL/status" 2>/dev/null || true)
    if [[ -n "$st" ]]; then
      state=$(echo "$st" | json 'print(d["state"])'); auto=$(echo "$st" | json 'print(d.get("autostart") or "")')
      [[ "$state" == "world" ]] && { echo "$st"; return 0; }
      [[ "$auto" == refused* ]] && { echo "autostart $auto" >&2; return 1; }
    fi
    sleep 5
  done
  echo "timed out waiting for the world" >&2; return 1
}

# A screenshot: the query is built from the options, the answer names the file relative to the profile.
shot() {
  local q="" out
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --size|--at|--look|--fov) [[ $# -ge 2 ]] || { echo "mtb shot: $1 needs a value" >&2; exit 2; }
                                q+="&${1#--}=$(urlq "$2")"; shift 2 ;;
      --day) q+="&day=1"; shift ;;
      -*) echo "mtb shot: unknown option $1 (see mtb help)" >&2; exit 2 ;;
      *)  q+="&name=$(urlq "$1")"; shift ;;
    esac
  done
  out=$(MTB_TIMEOUT="${MTB_TIMEOUT:-60}" req "$URL/screenshot?${q#&}")
  echo "$out" | PROFILE="$(profile_dir)" json '
import os
if "relative" not in d:
    e = d.get("error", d)
    print("mtb shot: " + ("this ModTestBridge has no screenshots (update the plugin to 0.2.0 or later)" if e == "unknown path" else str(e)), file=sys.stderr); sys.exit(1)
print(os.path.join(os.environ["PROFILE"], d["relative"]))
if d.get("blank"):
    print("mtb shot: the picture is black: is the game window minimised or hidden?", file=sys.stderr); sys.exit(3)'
}

doctor() {
  local dir ok=1
  echo "platform:   $([[ $WINDOWS == 1 ]] && echo Windows || { [[ -n "$(proton_prefix)" ]] && echo "Linux, Valheim under Proton" || echo "Linux, native Valheim"; })"
  if dir="$(profile_dir 2>&1)"; then echo "profile:    $dir"; else echo "profile:    ?? $dir"; ok=0; fi
  if (( ok )); then
    has_bridge "$dir" && echo "plugin:     installed" || echo "plugin:     ?? ModTestBridge.dll not under $dir/BepInEx/plugins"
    local cfg="$dir/BepInEx/config/Spronglehump.ModTestBridge.cfg"
    [[ -f "$cfg" ]] && echo "enabled:    $(sed -n 's/^Enabled = //p' "$cfg")" || echo "enabled:    (no config yet: run the game once)"
    [[ -f "$dir/BepInEx/config/ModTestBridge.token" ]] && echo "token:      found" || echo "token:      ?? none yet (written on the first run with Enabled = true)"
    echo "launch:     $(launch_cmd 2>/dev/null || echo '?? unknown: set MTB_LAUNCH')"
  fi
  echo "world:      ${MTB_WORLD:-(unset: MTB_WORLD)}   character: ${MTB_CHARACTER:-(unset: MTB_CHARACTER)}"
  echo "saves:      $(saves_dirs | while read -r d; do [[ -d "$d" ]] && echo -n "$d "; done)"
  echo "cloud:      $(cloud_dirs | tr '\n' ' ')"
  echo "game:       $(running && echo running || echo 'not running')"
  (( ok )) && echo "bridge:     $(MTB_TIMEOUT=5 req "$URL/status" 2>&1 || true)"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

if (( SERVER )); then
  case "${1:-status}" in
    start)   server_world "${2:-}"; running && { echo "the test server is already running (use mtb server restart)" >&2; exit 1; }
             server_check; backup || true; server_launch "$WORLD"; wait_server 600; exit ;;
    restart) server_world "${2:-}"; server_check; server_stop; backup || true; server_launch "$WORLD"; wait_server 600; exit ;;
    stop|quit) server_stop; exit ;;
    backup)  server_world "${2:-}"; backup; exit ;;
    doctor)  server_doctor; exit ;;
    shot)    echo "a dedicated server has no screen: take screenshots in the game (mtb shot)" >&2; exit 2 ;;
    status|cmd|run|log|tail|mark|wait-log|wait-world) ;;   # the same as in the game, below
    *)       usage; exit 2 ;;
  esac
fi

case "${1:-status}" in
  status) req "$URL/status" | json 'print(json.dumps(d))' ;;
  cmd)    shift; req -X POST --data-binary "$*" "$URL/command" | json 'print("\n".join(d.get("output") or [])) if "output" in d else print(d)' ;;
  run)
    [[ $# -ge 3 ]] || { echo 'usage: mtb run "<command>" "<text to wait for>" [timeout]' >&2; exit 2; }
    from=$(log_next)   # before the command, so a fast result isn't missed
    req -X POST --data-binary "$2" "$URL/command" | json 'print("\n".join(d.get("output") or [])) if "output" in d else print(d)'
    wait_log "$3" "${4:-600}" "$from" ;;
  log)    req "$URL/log?from=${2:-0}&contains=$(urlq "${3:-}")" \
            | json 'print("\n".join(d["lines"])); print("# next=%d" % d["next"], file=sys.stderr)' ;;
  tail)
    n="${2:-40}"; next=$(log_next)
    if [[ -n "${3:-}" ]]; then req "$URL/log?from=0&contains=$(urlq "$3")" | json "print('\n'.join(d['lines'][-$n:]))"
    else req "$URL/log?from=$(( next > n ? next - n : 0 ))" | json 'print("\n".join(d["lines"]))'; fi ;;
  mark)   log_next ;;
  wait-log) [[ $# -ge 2 ]] || { echo 'usage: mtb wait-log "<text>" [timeout]' >&2; exit 2; }; wait_log "$2" "${3:-600}" "$(log_next)" ;;
  wait-world) if (( SERVER )); then wait_server "${2:-300}"; else wait_in_world "${2:-300}"; fi ;;
  quit)   req -X POST --data "" "$URL/quit" | json 'print(d)' ;;
  start)  need_names "${2:-}" "${3:-}"; running && { echo "the game is already running (use mtb restart)" >&2; exit 1; }
          backup || true; launch "$WORLD" "$CHARACTER" ;;
  restart)
    need_names "${2:-}" "${3:-}"
    if running; then
      req -X POST --data "" "$URL/quit" >/dev/null 2>&1 || true
      end=$((SECONDS + 120)); while running && (( SECONDS < end )); do sleep 2; done
      running && { echo "the game didn't quit within 120 s" >&2; exit 1; }
      sleep 3
    fi
    backup || true
    launch "$WORLD" "$CHARACTER"
    wait_in_world 400 ;;
  backup)   need_names "${2:-}" "${3:-}"; backup ;;
  join)
    CHARACTER="${2:-${MTB_CHARACTER:-}}"; WORLD=""
    [[ -n "$CHARACTER" ]] || { echo "which character? pass it, or set MTB_CHARACTER" >&2; exit 2; }
    address="${3:-${MTB_SERVER_ADDRESS:-127.0.0.1:${MTB_SERVER_GAME_PORT:-2456}}}"
    if [[ -z "${3:-}${MTB_SERVER_ADDRESS:-}" ]]; then   # the local test server: is it up?
      [[ "$(SERVER=1 MTB_TIMEOUT=5 "$0" server status 2>/dev/null | json 'print(d["state"])' 2>/dev/null)" == world ]] \
        || { echo "the test server isn't up: mtb server start" >&2; exit 1; }
    fi
    if running; then
      req -X POST --data "" "$URL/quit" >/dev/null 2>&1 || true
      end=$((SECONDS + 120)); while running && (( SECONDS < end )); do sleep 2; done
      running && { echo "the game didn't quit within 120 s" >&2; exit 1; }
      sleep 3
    fi
    backup || true
    launch_join "$address" "$CHARACTER"
    wait_in_world 400 ;;
  profiles) bridge_profiles ;;
  doctor)   doctor ;;
  shot)   shift; shot "$@" ;;
  help|-h|--help) usage ;;
  *)      usage; exit 2 ;;
esac
